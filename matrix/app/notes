cypher-shell -u neo4j -p outra_senha_forte_aqui
 MATCH (n) RETURN n LIMIT 50;
 CALL db.labels();

 
MATCH (:Product {name: "Teste X1"})-[:HAS_COMPONENT]->(c:Component)
RETURN split(c.purl, ':')[1] AS ecossistema, count(*) AS total
ORDER BY total DESC;

MATCH (:Product {name: "Teste X1"})-[:HAS_COMPONENT]->(c:Component)
RETURN split(c.purl, ':')[1] AS ecossistema, count(*) AS total
ORDER BY total DESC
LIMIT 10;


#autodependencia problema serio como checar
MATCH (a:Component)-[:DEPENDS_ON]->(a) RETURN a.name;


MATCH (p:Product {name: "Teste V1"})
SET p.db_id = "1"
RETURN p;


CALL db.schema.visualization();
CALL db.labels();
CALL db.relationshipTypes();
CALL db.propertyKeys();

Conceito SQL (Relacional),         Conceito Neo4j (Grafos),         Comando de Inspeção
Tabela,                            Label (Rótulo de Nó),            CALL db.labels();
Linha/Registro,                    Node (Nó),                       MATCH (n:Label) RETURN n;
Coluna,                            Property (Propriedade),          CALL db.propertyKeys();
Foreign Key / Join,                Relationship (Relacionamento),   CALL db.relationshipTypes();


